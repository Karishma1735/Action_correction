PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DB_PATH=./data.db

# Escalation timing (minutes)
REMIND_AFTER_MINUTES=120
ESCALATE_AFTER_MINUTES=1440
SCHEDULER_TICK_SECONDS=30

# Delivery: "viasocket" (real) or "log" (dev only, prints messages to the console)
NOTIFIER=log

# viaSocket Embed (server-side only, never expose to the browser)
VIASOCKET_ORG_ID=4160
VIASOCKET_PROJECT_ID=projOEUNHFgu
VIASOCKET_EMBED_SECRET=

# Gemini agent (optional: without a key a simple rule-based summary is used)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shared secret that viaSocket/Slack callbacks must send as X-Callback-Secret
CALLBACK_SECRET=change-me

# Login. Everything under /api (except health, login and secret-signed callbacks) needs a session.
# APP_PASSWORD is the shared password; SESSION_SECRET signs the session cookie (long random string).
APP_PASSWORD=
SESSION_SECRET=
